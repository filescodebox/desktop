{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilesCodeBox",
  "version": "1.2.0",
  "identifier": "com.filescodebox.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FilesCodeBox",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "文件快递柜桌面客户端",
    "longDescription": "FilesCodeBox 桌面客户端：托盘常驻，一键连接你的文件快递柜。",
    "icon": [
      "icons/32x32.png",
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
